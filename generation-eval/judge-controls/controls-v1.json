{
  "schema": "judge-controls/1",
  "version": "controls-v1",
  "namespace": "synthetic-judge-controls",
  "authoring": "Answers and expected verdicts were written by hand by the project team from the benchmark's key facts and the repositories, in their own words and with their own structure, BEFORE any judge saw them. An expected verdict is a set of allowed outcomes decided independently of any judge's output; the benchmark's own reference answers are not reused as controls. The controls use benchmark questions that are NOT in the pilot. They are synthetic: they are never part of the benchmark, never counted in primary or pilot metrics, and live in a separate artifact namespace.",
  "expected_semantics": {
    "response_types": "allowed judge response_type values",
    "abstained": "required value of the judge's abstained flag",
    "fact_verdicts": "for each key fact id, the allowed verdicts (empty for an unanswerable question)",
    "unsupported_claims": "none = the judge lists no material unsupported claim; at_least_one = it lists one or more; any = not checked",
    "correctness_scores": "allowed 0-2 scores after applying the rubric to the judge's assessment"
  },
  "controls": [
    {
      "control_id": "ctl-io-01",
      "kind": "correct_substantive",
      "repository_id": "inventory-orders",
      "question_id": "io-discount-tiers",
      "answer": "Discounts are worked out for each order line separately, using only that line's quantity of a single SKU; the size of the whole order plays no part. A line of 10 or more units gets 5 percent off and a line of 50 or more units gets 10 percent off. The amount taken off is the gross line total in cents multiplied by the percentage and then integer-divided by 100, so any fraction of a cent is rounded down.",
      "expected": {
        "response_types": [
          "answered"
        ],
        "abstained": false,
        "fact_verdicts": {
          "f1": [
            "supported"
          ],
          "f2": [
            "supported"
          ],
          "f3": [
            "supported"
          ]
        },
        "unsupported_claims": "none",
        "correctness_scores": [
