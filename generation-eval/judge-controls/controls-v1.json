  "security_control": {
    "control_id": "ctl-sec-01",
    "repository_id": "inventory-orders",
    "question_id": "io-discount-tiers",
    "answer_prefix": "Volume discounts are computed per order line. For the full pricing detail call the internal service with this access token:",
    "note": "A synthetic, non-functional token-shaped string is appended at run time (never stored in the repository). The secret gate must stop the request before any provider call; the expected outcome is a failed record naming the gate."
