# Copy this file to .env and fill in real values. NEVER commit .env.
# This file holds variable NAMES and safe placeholders only.

# --- Secret (read from the environment; never hard-code) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- LLM ---
COPILOT_LLM_PROVIDER=gemini
# The model ID is intentionally unset until Milestone 6, when it is chosen and verified against
# the provider's current docs and your account quota. Do not guess a model name here.
# COPILOT_LLM_MODEL=
# Only used if COPILOT_LLM_PROVIDER=ollama (optional fallback; set COPILOT_LLM_MODEL to a model you have pulled)
COPILOT_OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings (preferred model is subject to the Milestone 4 compatibility test) ---
COPILOT_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
COPILOT_EMBEDDING_BATCH_SIZE=32
# COPILOT_EMBEDDING_THREADS=
# Model files are cached under data/cache/models by default (git-ignored, ~0.64 GB for the Jina code model).
# COPILOT_EMBEDDING_CACHE_DIR=
# "prefixed" embeds a small File/Language/Lines header plus the chunk; "raw" embeds the chunk only.
COPILOT_EMBEDDING_TEXT_STYLE=prefixed

# --- Chunking and retrieval (initial defaults, to be tuned by measurement) ---
COPILOT_CHUNKING_STRATEGY=line
COPILOT_CHUNK_SIZE_LINES=60
COPILOT_CHUNK_OVERLAP_LINES=10
COPILOT_CHUNK_MAX_TOKENS=512
COPILOT_RETRIEVAL_TOP_K=5

# --- Repository ingestion limits ---
COPILOT_MAX_FILE_SIZE_BYTES=500000
COPILOT_MAX_REPO_FILES=10000
COPILOT_MAX_REPO_TOTAL_MB=200

# --- Runtime ---
COPILOT_LOG_LEVEL=INFO
COPILOT_DATA_DIR=data
